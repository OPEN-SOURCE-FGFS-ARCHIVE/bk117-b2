			</volume>
			<pitch>
				<property>/rotors/main/rpm</property>
				<offset>0</offset>
				<factor>0.00201096605744</factor>
			</pitch>
			<position>
				<x>.1</x>
				<y>.14</y>
				<z>0.4</z>
			</position>
		</rotor>
		

<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>

  <path>switch.ac</path>

  <animation>
    <type>material</type>
    <object-name>Switch</object-name>
    <object-name>Circle</object-name>
    <object-name>SwitchNut</object-name>
    <object-name>SwitchRot</object-name>
    <emission>
          <red>0.001</red>
        <green>0.001</green>
        <blue>0.001</blue>
      <factor-prop>/systems/electrical/outputs/instrument-lights</factor-prop>
    </emission>
  </animation>

 
 
 <animation>
    <type>knob</type>
    <object-name>Switch</object-name>
  <property>controls/wiper/speed</property>
    <center>
      <x-m>0.00</x-m>
      <y-m>0.00</y-m>
      <z-m>0.000</z-m>
    </center>
    <axis>
      <x>0</x>
      <y>-1</y>
      <z>0</z>
    </axis>
    <factor>-45</factor>
    <action>
      <binding>
        <command>property-adjust</command>
       <property>controls/wiper/speed</property>
        <min>-1</min>
        <max>3</max>
        <wrap>false</wrap>
      </binding>
    </action>
  </animation>

</PropertyList>

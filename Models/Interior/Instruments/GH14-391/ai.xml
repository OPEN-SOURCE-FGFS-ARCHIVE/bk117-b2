<?xml version="1.0"?>
<PropertyList>

	<path>gh14391.ac</path>
	
	 <animation>
        <type>material</type>
		<object-name>ball</object-name>
		<object-name>face3</object-name>
            <emission>
      <factor-prop>/systems/electrical/outputs/instrument-lights</factor-prop>
            <red>0.0175</red>
            <green>0.0175</green>
            <blue>0.0175</blue>
    </emission>
	</animation>

	<animation>
		<type>rotate</type>
		<object-name>ball</object-name>
		<property>instrumentation/attitude-indicator/indicated-roll-deg</property>
		<center>
			<x-m>-0.075</x-m>
			<y-m>0.00</y-m>
			<z-m>0.004</z-m>
		</center>
		<axis>
			<x>1</x>
			<y>0</y>
			<z>0</z>
		</axis>
	</animation>
	
	<animation>
		<type>rotate</type>
		<object-name>face3</object-name>
		<property>instrumentation/attitude-indicator/indicated-roll-deg</property>
		<center>
			<x-m>0.007</x-m>
			<y-m>0.00</y-m>
			<z-m>0.004</z-m>
		</center>
		<axis>
			<x>1</x>
			<y>0</y>
			<z>0</z>
		</axis>
	</animation>

	<animation>
		<type>rotate</type>
		<object-name>ball</object-name>
		<property>instrumentation/attitude-indicator/indicated-pitch-deg</property>
		<factor>0.5</factor>
		<center>
			<x-m>-0.075</x-m>
			<y-m>0.00</y-m>
			<z-m>0.002</z-m>
		</center>
		<axis>
			<x>0</x>
			<y>1</y>
			<z>0</z>
		</axis>
	</animation>
	
<animation>
  <type>noshadow</type>
		<object-name>ball</object-name>
		<object-name>face3</object-name>
</animation>


	
<animation>
  <type>rotate</type>
  <object-name>slipball</object-name>
 <property>instrumentation/slip-skid-ball/indicated-slip-skid</property>
  <factor>5.729</factor>
<!--
   From the source for slip_skid_ball.cxx, the number returned is (-z_accel/y_accel)*10.
   For small theta, theta~=tan(theta) when theta is in radians.  So the angle of a "ball" 
   undergoing z_accel and y_accel hung on the end of a string makes with the verticle
   will be approximately -z_accel/y_accel radians. Converting to degrees, multiply by
   180/pi=57.29, or 5.729 times the returned value. Edited by Dave Perry, 2/26/06.
-->
  <min-deg>-5</min-deg>
  <max-deg>5</max-deg>
  <center>
   <x-m>0</x-m>
   <y-m>0</y-m>
   <z-m>0.25</z-m>  <!--  Makes the radius of curvature for the glass tube ~10 inches -->
  </center>
  <axis>
   <x>-1</x>
   <y>0</y>
   <z>0</z>
  </axis>
 </animation>
 
  <animation>
    <type>material</type>
	 <object-name>face3</object-name>
	 <object-name>ball</object-name>
	
     <object-name>slipball</object-name>
	 <object-name>face3</object-name>
		<object-name>Plane.004</object-name>
    <object-name>Plane.002</object-name>
    <emission>
      <factor-prop>/systems/electrical/outputs/instrument-lights</factor-prop>
            <red>0.0175</red>
            <green>0.0175</green>
            <blue>0.0175</blue>
    </emission>

  </animation>
  
<!-- Coompositor lights-->
  
  <light>
  <name>dash1</name>
  <type>spot</type>
  <position>
    <x-m>0.03</x-m>
    <y-m>0.0</y-m>
    <z-m>0</z-m>
  </position>
  <direction>
    <x>-1.0</x>
    <y>0</y>
    <z>0</z>
  </direction>
  <ambient>
    <r>0</r>
    <g>0</g>
    <b>1</b>
    <a>1</a>
  </ambient>
  <diffuse>
    <r>0</r>
    <g>1</g>
    <b>0</b>
    <a>1</a>
  </diffuse>
  <specular>
    <r>0</r>
    <g>1</g>
    <b>0</b>
    <a>1</a>
  </specular>
    <color>
      <r>0.8</r>
      <g>0.3</g>
      <b>0.3</b>
      <a>1.0</a>
    </color>
 <attenuation>
    <c>1</c>
    <l>1.5</l>
    <q>3.5</q>
  </attenuation>
  <spot-exponent>3</spot-exponent>
  <spot-cutoff>70</spot-cutoff>
  <range-m>0.05</range-m>
   <intensity>0.13</intensity>
  <dim-factor>
    <property>systems/electrical/outputs/instrument-lights</property>
  </dim-factor>
 
</light>


<animation>
  <type>select</type>
  <object-name>dash1</object-name>
		
  <condition>
  
   <equals>
    <property>controls/lighting/turn-off-lights</property>
    <value>true</value>
   </equals>
  
  </condition>
  </animation>

</PropertyList>

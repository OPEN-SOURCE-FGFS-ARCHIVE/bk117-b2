<?xml version="1.0" ?>

<PropertyList>
    <path>masterwarn.ac</path>

    <animation>
        <type>range</type>
        <min-m>0</min-m>
        <max-m>10</max-m>
    </animation>
    
    <animation>
      <type>material</type>
      <property-base>sim/model/material/cockpit</property-base>
      <object-name>face</object-name>
      <object-name>auto</object-name>
      <object-name>direction</object-name>
      <emission>
        <red-prop>red</red-prop>
        <green-prop>green</green-prop>
        <blue-prop>blue</blue-prop>
        <factor-prop>factor</factor-prop>
      </emission>
    </animation>
	
	
	 <animation>
  <type>material</type>
  <object-name>caution</object-name>
    <object-name>master</object-name>
  <ambient>
    <red>0.8</red>
    <green>0.</green>
    <blue>0.0</blue>
  </ambient>
  <diffuse>
    <red>0.5</red>
    <green>0.0</green>
    <blue>0.0</blue>
  </diffuse>
  <emission>
    <red>0.5</red>
    <green>0.0</green>
    <blue>0.0</blue>
  </emission> 
 </animation>
 
 
 <text>
  <name>master</name>
  <font>lcd.txf</font>
  <character-size type="double">0.004</character-size>
  <offsets>
     <x-m>0.003</x-m>
     <y-m>-0.009</y-m>
     <z-m>0.0047</z-m>
   <roll-deg>0</roll-deg>
  </offsets>
  <axis-alignment>yz-plane</axis-alignment>
  <type type="string">literal</type>
  <text type="string">MASTER</text>
  <draw-text type="bool">true</draw-text>
  <alignment>left-top</alignment>
 </text>
 
  <text>
  <name>caution</name>
  <font>lcd.txf</font>
  <character-size type="double">0.004</character-size>
  <offsets>
     <x-m>0.003</x-m>
     <y-m>-0.0105</y-m>
     <z-m>0</z-m>
   <roll-deg>0</roll-deg>
  </offsets>
  <axis-alignment>yz-plane</axis-alignment>
  <type type="string">literal</type>
  <text type="string">CAUTION</text>
  <draw-text type="bool">true</draw-text>
  <alignment>left-top</alignment>
 </text>
 
 
  <animation>
        <type>select</type>
      
    <object-name>master</object-name>
	<object-name>caution</object-name>
        
	 <condition>
		
			 <or>
		<less-than>
			<property>consumables/fuel/total-fuel-lbs</property>
			<value>190</value>
		</less-than>

		<not>
			<property>engines/engine[0]/running</property>
		</not>
	
		<less-than>
			<property>engines/engine/n1-rpm</property>
			<value>31000</value>
		</less-than>
	
		<less-than>
			<property>rotors/main/rpm</property>
			<value>352</value>
		</less-than>

		<less-than>
      <property>rotors/gear/mgb-oil-pressure-norm</property>
	  <value>3.5</value>
	  </less-than>
		
	   </or>
	
			
			</condition>
    </animation>

</PropertyList>

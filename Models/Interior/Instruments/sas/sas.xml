<?xml version="1.0" ?>

<PropertyList>
    <path>sas.ac</path>

    <animation>
        <type>range</type>
        <min-m>0</min-m>
        <max-m>10</max-m>
    </animation>
    
    <animation>
      <type>material</type>
      <property-base>sim/model/material/cockpit</property-base>
      <object-name>face</object-name>
      <object-name>auto</object-name>
      <object-name>direction</object-name>
      <emission>
        <red-prop>red</red-prop>
        <green-prop>green</green-prop>
        <blue-prop>blue</blue-prop>
        <factor-prop>factor</factor-prop>
      </emission>
    </animation>
	
	
	<!-- switches -->
	
	<!-- SAS -->
	
	<model>
		
		<path>Aircraft/bk117-b2/Models/Interior/Instruments/switches/sas.xml</path>
		<offsets>
		<x-m>0</x-m>
			<y-m>-0.0063</y-m>
			<z-m>0.001</z-m>
			<pitch-deg>0</pitch-deg>
			<roll-deg>0</roll-deg>
		</offsets>

		<overlay>
		 <animation n="100">
    <type>scale</type>
    <property>constants/zero</property>
    <x-offset>1</x-offset>
    <y-offset>0.6</y-offset>
    <z-offset>0.6</z-offset>
   </animation>
  </overlay>
		
		
		</model>
		
		
	<!-- CAS -->
	
	<model>
		
		<path>Aircraft/bk117-b2/Models/Interior/Instruments/switches/cas.xml</path>
		<offsets>
		<x-m>0</x-m>
			<y-m>0.0118</y-m>
			<z-m>0.001</z-m>
			<pitch-deg>0</pitch-deg>
			<roll-deg>0</roll-deg>
		</offsets>

		<overlay>
		 <animation n="100">
    <type>scale</type>
    <property>constants/zero</property>
    <x-offset>1</x-offset>
    <y-offset>0.6</y-offset>
    <z-offset>0.6</z-offset>
   </animation>
  </overlay>
		
		
		</model>	
		
		<!-- not used -->
		
			<model>
		
		<path>Aircraft/bk117-b2/Models/Interior/Instruments/switches/spare.xml</path>
		<offsets>
		<x-m>0</x-m>
			<y-m>0.0518</y-m>
			<z-m>0.001</z-m>
			<pitch-deg>0</pitch-deg>
			<roll-deg>0</roll-deg>
		</offsets>

		<overlay>
		 <animation n="100">
    <type>scale</type>
    <property>constants/zero</property>
    <x-offset>1</x-offset>
    <y-offset>0.6</y-offset>
    <z-offset>0.6</z-offset>
   </animation>
  </overlay>
		
		
		</model>	
		
	<model>
		
		<path>Aircraft/bk117-b2/Models/Interior/Instruments/switches/spare.xml</path>
		<offsets>
		<x-m>0</x-m>
			<y-m>0.0693</y-m>
			<z-m>0.001</z-m>
			<pitch-deg>0</pitch-deg>
			<roll-deg>0</roll-deg>
		</offsets>

		<overlay>
		 <animation n="100">
    <type>scale</type>
    <property>constants/zero</property>
    <x-offset>1</x-offset>
    <y-offset>0.6</y-offset>
    <z-offset>0.6</z-offset>
   </animation>
  </overlay>
		
		
		</model>		


</PropertyList>

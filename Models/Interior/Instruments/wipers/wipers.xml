<?xml version="1.0" ?>

<PropertyList>
    <path>wipers.ac</path>

    <animation>
        <type>range</type>
        <min-m>0</min-m>
        <max-m>10</max-m>
    </animation>
    
    <animation>
      <type>material</type>
      <property-base>sim/model/material/cockpit</property-base>
      <object-name>face</object-name>
      <object-name>auto</object-name>
      <object-name>direction</object-name>
      <emission>
        <red-prop>red</red-prop>
        <green-prop>green</green-prop>
        <blue-prop>blue</blue-prop>
        <factor-prop>factor</factor-prop>
      </emission>
    </animation>

   <model>
		
		<path>wiperswitch.xml</path>
		<offsets>
			<x-m>0</x-m>
			<y-m>0</y-m>
			<z-m>0</z-m>
			<pitch-deg>0</pitch-deg>
		</offsets>
		</model>	

</PropertyList>

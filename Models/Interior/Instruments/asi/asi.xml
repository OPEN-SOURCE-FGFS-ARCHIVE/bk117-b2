<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>asi.ac</path>
	
  <animation>
    <object-name>fond</object-name>
    <object-name>face</object-name>
    <object-name>asi-needle1</object-name>

	


  </animation>
<!--Working For Rembrandt-->

<animation>
<object-name>vitre</object-name>
</animation>

<animation>
<type>noshadow</type>
<object-name>vitre</object-name>
</animation>


<effect>
    <inherits-from>interior-glass-reflection-panel-front</inherits-from>
    <object-name>vitre</object-name>
  </effect>
<!--
<animation>
<type>shader</type>
<shader>chrome</shader>
<texture>Aircraft/Generic/Effects/glass_shader.png</texture>
<object-name>vitre</object-name>
</animation>
-->
<!--Working For Rembrandt-->

  <animation>
    <type>material</type>
    <object-name>face</object-name>
    <object-name>asi-needle1</object-name>
   <emission>
      <factor-prop>/systems/electrical/outputs/instrument-lights</factor-prop>
            <red>0.0175</red>
            <green>0.0175</green>
            <blue>0.0175</blue>
    </emission>
  </animation>

 <animation>
    <type>material</type>
    <object-name>fond</object-name>
    
    <emission>
      <factor-prop>/controls/lighting/landing-lights</factor-prop>
  <red>1.0</red>
			<green>1.0</green>
			<blue>1.0</blue>
    </emission>
  </animation>
	
  <animation>
    <type>rotate</type>
    <object-name>asi-needle1</object-name>
    <property>/instrumentation/airspeed-indicator/indicated-speed-kt</property>
   <interpolation>
      <entry><ind> -999 </ind><dep>   0 </dep></entry>
      <entry><ind>    0 </ind><dep>   0 </dep></entry>
      <entry><ind>   10 </ind><dep>   5 </dep></entry>
      <entry><ind>   20 </ind><dep>  10 </dep></entry>
      <entry><ind>   30 </ind><dep>  30 </dep></entry>
      <entry><ind>   40 </ind><dep>  60 </dep></entry>
      <entry><ind>   50 </ind><dep>  90 </dep></entry>
      <entry><ind>   60 </ind><dep> 120 </dep></entry>
      <entry><ind>   70 </ind><dep> 152 </dep></entry>
      <entry><ind>   80 </ind><dep> 183 </dep></entry>
      <entry><ind>   90 </ind><dep> 205 </dep></entry>
      <entry><ind>  100 </ind><dep> 215 </dep></entry>
      <entry><ind>  120 </ind><dep> 250 </dep></entry>
      <entry><ind>  140 </ind><dep> 275 </dep></entry>
      <entry><ind>  160 </ind><dep> 303 </dep></entry>
      <entry><ind>  180 </ind><dep> 330 </dep></entry>
      <entry><ind>  999 </ind><dep> 359 </dep></entry>
    </interpolation>
    <axis>
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>
  
  <!-- Coompositor lights-->
  
  <light>
  <name>dash1</name>
  <type>spot</type>
  <position>
    <x-m>0.03</x-m>
    <y-m>0.0</y-m>
    <z-m>0</z-m>
  </position>
  <direction>
    <x>-1.0</x>
    <y>0</y>
    <z>0</z>
  </direction>
  <ambient>
    <r>0</r>
    <g>0</g>
    <b>1</b>
    <a>1</a>
  </ambient>
  <diffuse>
    <r>0</r>
    <g>1</g>
    <b>0</b>
    <a>1</a>
  </diffuse>
  <specular>
    <r>0</r>
    <g>1</g>
    <b>0</b>
    <a>1</a>
  </specular>
    <color>
      <r>0.8</r>
      <g>0.3</g>
      <b>0.3</b>
      <a>1.0</a>
    </color>
 <attenuation>
    <c>1</c>
    <l>1.5</l>
    <q>3.5</q>
  </attenuation>
  <spot-exponent>3</spot-exponent>
  <spot-cutoff>70</spot-cutoff>
  <range-m>0.05</range-m>
   <intensity>0.13</intensity>
  <dim-factor>
    <property>systems/electrical/outputs/instrument-lights</property>
  </dim-factor>
 
</light>


<animation>
  <type>select</type>
  <object-name>dash1</object-name>
		
  <condition>
  
   <equals>
    <property>controls/lighting/turn-off-lights</property>
    <value>true</value>
   </equals>
  
  </condition>
  </animation>

</PropertyList>


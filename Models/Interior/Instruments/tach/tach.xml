<?xml version="1.0"?>

<PropertyList>
	<path>tach.ac</path>

	<animation>
		<type>rotate</type>
		<object-name>TurbineNeedle1</object-name>
		<property>engines/engine[0]/n2-pct</property>
		<interpolation>
			<entry><ind>0</ind><dep>35</dep></entry>
			<entry><ind>50</ind><dep>151</dep></entry>
			<entry><ind>100</ind><dep>267</dep></entry>
			<entry><ind>140</ind><dep>360</dep></entry>
		</interpolation>
		<axis>
			<x>-1</x>
		</axis>
	</animation>

	<animation>
		<type>rotate</type>
		<object-name>TurbineNeedle2</object-name>
		<property>engines/engine[1]/n2-pct</property>
		<interpolation>
			<entry><ind>0</ind><dep>35</dep></entry>
			<entry><ind>50</ind><dep>151</dep></entry>
			<entry><ind>100</ind><dep>267</dep></entry>
			<entry><ind>140</ind><dep>360</dep></entry>
		</interpolation>
		<axis>
			<x>-1</x>
		</axis>
	</animation>

	<animation>
		<type>rotate</type>
		<object-name>RotorNeedle</object-name>
		<property>rotors/main/rpm</property>
		<interpolation>
			<entry><ind>0</ind><dep>35</dep></entry>
			<entry><ind>221</ind><dep>151</dep></entry>
			<entry><ind>442</ind><dep>267</dep></entry>
			<entry><ind>619</ind><dep>360</dep></entry>
		</interpolation>
		<axis>
			<x>-1</x>
		</axis>
	</animation>
	
	 <animation>
    <type>material</type>
    <object-name>RotorNeedle</object-name>
	<object-name>TurbineNeedle1</object-name>
		<object-name>TurbineNeedle2</object-name>
		<object-name>Face</object-name>
    <object-name>needle</object-name>
    <emission>
      <factor-prop>/systems/electrical/outputs/instrument-lights</factor-prop>
            <red>0.0175</red>
            <green>0.0175</green>
            <blue>0.0175</blue>
    </emission>
  </animation>
	
	
 <model>
		
		<path>Aircraft/bk117-b2/Models/Interior/Instruments/surround/surround.xml</path>
		<offsets>
			<x-m>0</x-m>
			<y-m>0</y-m>
			<z-m>0.002</z-m>
			<pitch-deg>0</pitch-deg>
		</offsets>
		<overlay>
		 <animation n="900">
    <type>scale</type>
    <property>constants/zero</property>
    <x-offset>1</x-offset>
    <y-offset>1.08</y-offset>
    <z-offset>1.08</z-offset>
   </animation>
  </overlay>
		</model>

<!-- Coompositor lights-->
  
  <light>
  <name>dash1</name>
  <type>spot</type>
  <position>
    <x-m>0.03</x-m>
    <y-m>0.0</y-m>
    <z-m>0</z-m>
  </position>
  <direction>
    <x>-1.0</x>
    <y>0</y>
    <z>0</z>
  </direction>
  <ambient>
    <r>0</r>
    <g>0</g>
    <b>1</b>
    <a>1</a>
  </ambient>
  <diffuse>
    <r>0</r>
    <g>1</g>
    <b>0</b>
    <a>1</a>
  </diffuse>
  <specular>
    <r>0</r>
    <g>1</g>
    <b>0</b>
    <a>1</a>
  </specular>
    <color>
      <r>0.8</r>
      <g>0.3</g>
      <b>0.3</b>
      <a>1.0</a>
    </color>
 <attenuation>
    <c>1</c>
    <l>1.5</l>
    <q>3.5</q>
  </attenuation>
  <spot-exponent>3</spot-exponent>
  <spot-cutoff>70</spot-cutoff>
  <range-m>0.05</range-m>
   <intensity>0.13</intensity>
  <dim-factor>
    <property>systems/electrical/outputs/instrument-lights</property>
  </dim-factor>
 
</light>


<animation>
  <type>select</type>
  <object-name>dash1</object-name>
		
  <condition>
  
   <equals>
    <property>controls/lighting/turn-off-lights</property>
    <value>true</value>
   </equals>
  
  </condition>
  </animation>		
	
</PropertyList>


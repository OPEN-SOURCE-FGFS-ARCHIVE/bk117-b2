<?xml version="1.0"?>
<PropertyList>

    <path>N1.ac</path>

 <animation>
  <type>scale</type>
  <x-offset>0.59</x-offset>
  <y-offset>0.59</y-offset>
  <z-offset>0.59</z-offset>
 </animation>

    <animation>
        <type>material</type>
        <object-name>N1.face</object-name>
        <object-name>N1.needle</object-name>
        <emission>
            <red>0.0175</red>
            <green>0.0175</green>

<?xml version="1.0"?>

<PropertyList>

<path>int-temp.ac</path>

 
 
    <animation>
        <type>material</type>
        <object-name>Temp1.face</object-name>
        <object-name>Temp1.needle</object-name>
        <emission>
            <red>0.0175</red>
            <green>0.0175</green>
            <blue>0.0175</blue>
            <factor-prop>/systems/electrical/outputs/instrument-lights</factor-prop>
        </emission>
    </animation>

	<animation>
		<type>range</type>
		<min-m>0</min-m>
		<max-m>5</max-m>
	</animation>

	
	<model>
		
		<path>Aircraft/bk117-b2/Models/Interior/Instruments/surround/surround.xml</path>
		<offsets>
			<x-m>0</x-m>
			<y-m>0</y-m>
			<z-m>0.001</z-m>
			<pitch-deg>0</pitch-deg>
		</offsets>
		<overlay>
		 <animation n="900">
    <type>scale</type>
    <property>constants/zero</property>
    <x-offset>1</x-offset>
    <y-offset>0.5</y-offset>
    <z-offset>0.5</z-offset>
   </animation>
  </overlay>
		</model>	
</PropertyList>

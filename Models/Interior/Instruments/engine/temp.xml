<?xml version="1.0"?>

<PropertyList>

	<path>temp.ac</path>
    <animation>
        <type>material</type>
        <object-name>Temp.face</object-name>
        <object-name>Temp.needle</object-name>
        <emission>
            <red>0.0175</red>
            <green>0.0175</green>
            <blue>0.0175</blue>
            <factor-prop>/systems/electrical/outputs/instrument-lights</factor-prop>
        </emission>
		
		

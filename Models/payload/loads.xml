    <property>sim/multiplay/generic/string[1]</property>
    <value>Military Transport</value>
   </equals>
   
  </or>
  </condition>
 </animation>
 
  <model>
		<name>Floatation_System</name>
		<path>Aircraft/bk117-b2/Models/Divers/Floats/Floats.xml</path>
		<offsets>
			<x-m>0</x-m>
            <y-m>  0.00000 </y-m>
            <z-m>0 </z-m>
			<pitch-deg>0</pitch-deg>
			<heading-deg>0</heading-deg>
		</offsets>
	</model>
  <animation>
    <type>select</type>
    <object-name>Floatation_System</object-name>      
    <condition>
     
        <equals>
          <property>sim/multiplay/generic/string[2]</property>
          <value>Floatation_System</value>
        </equals>
       
    </condition>
  </animation>
  
  <animation>
  <type>select</type>

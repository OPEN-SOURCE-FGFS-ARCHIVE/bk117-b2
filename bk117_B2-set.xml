<PropertyList>
	<sim>
		<minimum-fg-version>2017.3.0</minimum-fg-version>
		<description>MBB BK117 B2</description>
		<author>Melchior Franz (Nasal  + config)Heiko Schulz, Maik Justus + StuartC (FDM), Melchior Franz (Nasal) Geed ( sound FX)</author>
		<status>Production</status>
		<license>GPL v2</license>
		<aircraft-version>1.46HDR</aircraft-version>

		<flight-model>yasim</flight-model>
		<aero>bk117</aero>
		<fuel-fraction>1</fuel-fraction>

		<rating>
			<FDM type="int">4</FDM>
			<systems type="int">3</systems>
			<cockpit type="int">3</cockpit>
			<model type="int">4</model>
		</rating>

		<tags>
			<tag>Eurocopter</tag>
			<tag>helicopter</tag>
			<tag>2-engine</tag>
			<tag>Airbus Helicopters</tag>
			<tag>BK-117 </tag>
			<tag>H-145</tag>
			<tag>FGUK</tag>
			<tag>1980's</tag>
			<tag>1990s</tag>
			<tag>2000s</tag>
		</tags>


		<previews>
			<preview>
				<type>exterior</type>
				<splash type="bool">true</splash>
				<path>Splash/splash01.png</path>
			</preview>
			<preview>
				<type>exterior</type>
				<splash type="bool">true</splash>
				<path>Splash/splash02.png</path>
			</preview>
			<preview>
				<type>exterior</type>
				<splash type="bool">true</splash>
				<path>Splash/splash03.png</path>
			</preview>
			<preview>
				<type>exterior</type>
				<splash type="bool">true</splash>
				<path>Splash/splash04.png</path>
			</preview>
			<preview>
				<type>exterior</type>
				<splash type="bool">true</splash>
				<path>Splash/fgfs-20240204201742.png</path>
			</preview>
			<preview>
				<type>exterior</type>
				<splash type="bool">true</splash>
				<path>Splash/fgfs-20240204195340.png</path>
			</preview>
		</previews>

		<flight-recorder include="Systems/flight-recorder.xml" />

		<hud>
			<path n="1">Aircraft/bk117-b2/Hud/hud.xml</path>
			<visibility n="1">true</visibility>

			<palette>
				<color n="0">
					<alpha type="float">0.85</alpha>
					<antialiased type="bool">true</antialiased>
					<brightness type="float">0.85</brightness>
					<transparent type="bool">true</transparent>
					<red type="float">0.38</red>
					<green type="float">0.38</green>
					<blue type="float">0.22</blue>
				</color>

			</palette>

		</hud>

		<multiplay>
			<generic>
				<!-- Nav lights on -->
				<!-- Nav lights on -->
				<int n="0" alias="/controls/switches/nav-lights-switch" />
				<!-- Beacon on -->
				<int n="1" alias="/controls/switches/beacon-switch" />
				<!-- Landing lights on -->
				<int n="2" alias="/controls/switches/landing-lights-switch" />
				<!-- Taxi light on -->
				<int n="3" alias="/controls/switches/strobe-switch" />

				<int n="6" alias="/gear/gear/ground-is-solid" /> <!-- rotor particles -->
				<!-- Crashed -->
				<int n="7" alias="/sim/crashed" />
				<!-- search light on -->
				<int n="8" alias="/controls/switches/search-lights-switch" />
				<!-- Float Inflation -->
				<int n="9" alias="/controls/gear/floats-inflat" />

				<float n="0" alias="/sim/model/bk117/door-positions/rightFrontDoor/position-norm" />
				<float n="1" alias="/sim/model/bk117/door-positions/leftFrontDoor/position-norm" />
				<float n="2" alias="/sim/model/bk117/door-positions/rightBackDoor/position-norm" />
				<float n="3" alias="/sim/model/bk117/door-positions/leftBackDoor/position-norm" />
				<float n="4" alias="/sim/model/bk117/door-positions/rightRearDoor/position-norm" />
				<float n="5" alias="/sim/model/bk117/door-positions/leftRearDoor/position-norm" />
				<float n="6" alias="/orientation/pitch-deg" /> <!-- rotor particles -->
				<float n="7" alias="/position/gear-agl-m" /> <!-- rotor particles -->
				<float n="8" alias="/orientation/roll-deg" /> <!-- rotor particles -->
				<float n="9" alias="/rotors/main/torque" /> <!-- rotor particles -->
				<float n="10" alias="/sim/model/turret-positions/turretx" /> <!--Searchlight over MP -->
				<float n="11" alias="/sim/model/turret-positions/turretz" /> <!--searchlight over MP -->
				<float n="12" alias="/sim/model/rescue" /> <!--winchman over MP -->
				<float n="13" alias="/sim/model/rescue-lift" /> <!--winchman over MP -->
				<float n="14" alias="/controls/wiper/posp" /> <!--wiper over MP -->
				<string n="1" alias="/sim/weight[5]/selected" /> <!-- Payload over multiplayer -->
				<string n="2" alias="/sim/weight[6]/selected" /> <!-- configuration over multiplayer -->

			</generic>
		</multiplay>

		<sound>
			<path>Aircraft/bk117-b2/Sounds/sound.xml</path>
		</sound>


		<systems>
			
<autopilot>   
	   
    <fdm>
      <max-pitch>10</max-pitch>
     
      <max-speed>115</max-speed>
      <min-speed>-15</min-speed>
     
    </fdm>
    
  
  
    <speed>
    <enabled>true</enabled>
    <target>100</target>
    <mode>pitch-control</mode>
    <pitch-control>
      <gain>5</gain>
    </pitch-control>
  </speed>
  
 
    <fly-by-wire>
      <enabled>true</enabled>
      <mode>normal</mode>
    </fly-by-wire>
	
	
  </autopilot>
			<autopilot n="101">
				<path>Aircraft/bk117-b2/Systems/autopilotH2.xml</path>
			</autopilot>


			<autopilot n="102">
				<path>Aircraft/bk117-b2/Systems/glass-rain.xml</path>
			</autopilot>

			<autopilot n="103">
				<path>Aircraft/bk117-b2/Systems/sound-rules.xml</path>
			</autopilot>
		</systems>


		<model>
			<path archive="y">Aircraft/bk117-b2/Models/BK-117_B2.xml</path>
			<rescue-lift>0.01</rescue-lift>
			<rescue type="bool">false</rescue>

			<bk117>

				<rotor-partcles>true</rotor-partcles>
				<headsetholder>
					<position-deg type="float">90.0</position-deg>
				</headsetholder>
				 <!--  For switching between shiny and non shiny paint in HDR mode -->
                <hdr>true</hdr>
				<als>false</als>
				<livery>
					<file type="string">FGUK</file>
			</livery>
			</bk117>
		</model>
		<rendering>
			<refl_correction type="string">-0.22</refl_correction>
			<frensel-factor type="string">0.5</frensel-factor>
		</rendering>

		<airport>
			<runways>
				<start-offset-m>3.3</start-offset-m>
			</runways>
		</airport>

		<!--view-->
		<view n="0">
			<name>Cockpit</name>
			<type>lookfrom</type>
			<internal type="bool">true</internal>
			<config>
				<x-offset-m type="double">0.43</x-offset-m> <!--left-->
				<y-offset-m type="double">0.25</y-offset-m> <!--up-->
				<z-offset-m type="double">0.86</z-offset-m> <!--back-->
				<pitch-offset-deg>-14</pitch-offset-deg>
				<default-field-of-view-deg type="double">60.0</default-field-of-view-deg>
			</config>
		</view>


		<view n="101">
			<name>Pilot cam</name>
			<type>lookfrom</type>
			<internal type="bool">true</internal>
			<config>
				<from-model type="bool">true</from-model>
				<from-model-idx type="int">0</from-model-idx>
				<x-offset-m type="double">0</x-offset-m> <!--left-->
				<y-offset-m type="double">0.43</y-offset-m> <!--up-->
				<z-offset-m type="double">0.5</z-offset-m> <!--back-->
				<pitch-offset-deg>-20</pitch-offset-deg>
				<heading-offset-deg>199</heading-offset-deg>
				<default-field-of-view-deg>110</default-field-of-view-deg>
			</config>

		</view>

		<view n="102">
			<name>Over the shoulder</name>
			<type>lookfrom</type>
			<internal type="bool">true</internal>
			<config>
				<from-model type="bool">true</from-model>
				<from-model-idx type="int">0</from-model-idx>
				<x-offset-m archive="y">0.1</x-offset-m> <!--right-->
				<y-offset-m archive="y">0.4.7</y-offset-m> <!--up-->
				<z-offset-m archive="y">1.15</z-offset-m> <!--back-->
				<pitch-offset-deg>-14</pitch-offset-deg>
				<heading-offset-deg>0</heading-offset-deg>
				<default-field-of-view-deg>95</default-field-of-view-deg>
			</config>

		</view>

		<view n="103">
			<name>Cabin view</name>
			<type>lookfrom</type>
			<internal type="bool">true</internal>
			<config>
				<from-model type="bool">true</from-model>
				<from-model-idx type="int">0</from-model-idx>
				<x-offset-m archive="y">0.1</x-offset-m> <!--right-->
				<y-offset-m archive="y">0.4.7</y-offset-m> <!--up-->
				<z-offset-m archive="y">1.2</z-offset-m> <!--back-->
				<pitch-offset-deg>-14</pitch-offset-deg>
				<heading-offset-deg>180</heading-offset-deg>
				<default-field-of-view-deg>95</default-field-of-view-deg>
			</config>

		</view>


		<view n="104">
			<name>FLIR</name>
			<type>lookfrom</type>
			<internal type="bool">false</internal>
			<config>
				<from-model type="bool">true</from-model>
				<from-model-idx type="int">0</from-model-idx>
				<x-offset-m archive="y">1.1</x-offset-m> <!--right-->
				<y-offset-m archive="y">-1</y-offset-m> <!--up-->
				<z-offset-m archive="y">0.1</z-offset-m> <!--back-->
				<pitch-offset-deg>0</pitch-offset-deg>
				<heading-offset-deg>0</heading-offset-deg>
				<default-field-of-view-deg>65</default-field-of-view-deg>
				<limits>
					<enabled type="bool">true</enabled>
					<left>
						<heading-max-deg type="double">110</heading-max-deg>
						<x-offset-max-m type="double">0.20</x-offset-max-m>
						<x-offset-threshold-deg type="double">25</x-offset-threshold-deg>
					</left>
					<right>
						<heading-max-deg type="double">160</heading-max-deg>
						<x-offset-max-m type="double">0.20</x-offset-max-m>
						<x-offset-threshold-deg type="double">25</x-offset-threshold-deg>
					</right>
				</limits>
			</config>

			<flir type="bool">true</flir>
		</view>


		<view n="1">
			<config>
				<target-z-offset-m archive="y" type="double">2.5</target-z-offset-m>
			</config>
		</view>

		<view n="2">
			<config>
				<target-z-offset-m archive="y" type="double">2.5</target-z-offset-m>
